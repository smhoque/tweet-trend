pipeline {

    agent {
        node {
            label 'maven'
        }
    }

    environment {
        PATH = "/opt/apache-maven-3.9.16/bin:${env.PATH}"
        SCANNER_HOME = tool('valaxy-sonar-scanner')
        REGISTRY = 'https://trialuljnwv.jfrog.io'
    }

    stages {

        stage('Checkout') {
            steps {
                echo "========== Checking out source code =========="
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "========== Build Started =========="
                sh 'mvn clean deploy -DskipTests'
                echo "========== Build Completed =========="
            }
        }

        stage('Unit Test Report') {
            steps {
                echo "========== Generating Unit Test Report =========="
                sh 'mvn surefire-report:report'
                echo "========== Report Generated =========="
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "========== SonarQube Analysis Started =========="

                withSonarQubeEnv('valaxy-sonar-server') {
                    sh "${SCANNER_HOME}/bin/sonar-scanner"
                }

                echo "========== SonarQube Analysis Completed =========="
            }
        }

        stage('Jar Publish') {
            steps {
                script {

                    echo "========== Jar Publish Started =========="

                    def server = Artifactory.newServer(
                        url: "${REGISTRY}/artifactory",
                        credentialsId: "artifactory_token"
                    )

                    def properties = "buildid=${env.BUILD_ID};commitid=${env.GIT_COMMIT}"

                    def uploadSpec = """{
                      "files": [
                        {
                          "pattern": "jarstaging/(*)",
                          "target": "mvn-libs-release-local/{1}",
                          "flat": "false",
                          "props": "${properties}",
                          "exclusions": [
                            "*.sha1",
                            "*.md5"
                          ]
                        }
                      ]
                    }"""

                    def buildInfo = server.upload(uploadSpec)

                    buildInfo.env.collect()
                    server.publishBuildInfo(buildInfo)

                    echo "========== Jar Publish Completed =========="
                }
            }
        }

    }

    post {

        always {
            echo "========== Pipeline Finished =========="
        }

        success {
            echo "========== Pipeline Succeeded =========="
        }

        failure {
            echo "========== Pipeline Failed =========="
        }

        unstable {
            echo "========== Pipeline Unstable =========="
        }
    }
}