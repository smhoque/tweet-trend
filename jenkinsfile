pipeline {

    agent {
        node {
            label 'maven'
        }
    }

    environment {
        PATH = "/opt/apache-maven-3.9.16/bin:${env.PATH}"
        SCANNER_HOME = tool('valaxy-sonar-scanner')

        REGISTRY   = 'https://trialuljnwv.jfrog.io'
        IMAGE_NAME = 'trialuljnwv.jfrog.io/valaxy-docker-local/ttrend'
        VERSION    = '2.1.2'
    }

    stages {

        stage('Checkout') {
            steps {
                echo "========== Checkout =========="
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "========== Maven Build =========="
                sh 'mvn clean deploy -DskipTests'
            }
        }

        stage('Unit Test Report') {
            steps {
                echo "========== Unit Test Report =========="
                sh 'mvn surefire-report:report'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "========== SonarQube Analysis =========="

                withSonarQubeEnv('valaxy-sonar-server') {
                    sh "${SCANNER_HOME}/bin/sonar-scanner"
                }
            }
        }

        stage('Jar Publish') {
            steps {
                script {

                    echo "========== Publishing JAR =========="

                    def server = Artifactory.newServer(
                        url: "${REGISTRY}/artifactory",
                        credentialsId: "artifactory_token"
                    )

                    def properties = "buildid=${env.BUILD_ID};commitid=${env.GIT_COMMIT}"

                    def uploadSpec = """{
                      "files": [
                        {
                          "pattern": "jarstaging/(*)",
                          "target": "mvn-libs-release-local/{1}",
                          "flat": "false",
                          "props": "${properties}",
                          "exclusions": [
                            "*.sha1",
                            "*.md5"
                          ]
                        }
                      ]
                    }"""

                    def buildInfo = server.upload(uploadSpec)

                    buildInfo.env.collect()
                    server.publishBuildInfo(buildInfo)

                    echo "========== JAR Published =========="
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {

                    echo "========== Docker Build Started =========="

                    def app = docker.build("${IMAGE_NAME}:${VERSION}")

                    env.DOCKER_IMAGE = "${IMAGE_NAME}:${VERSION}"

                    echo "========== Docker Build Completed =========="
                }
            }
        }

        stage('Docker Publish') {
            steps {
                script {

                    echo "========== Docker Push Started =========="

                    docker.withRegistry("${REGISTRY}", "artifactory_token") {

                        docker.image(env.DOCKER_IMAGE).push()

                    }

                    echo "========== Docker Push Completed =========="
                }
            }
        }

    }

    post {

        always {
            echo "========== Pipeline Finished =========="
        }

        success {
            echo "========== Pipeline Succeeded =========="
        }

        failure {
            echo "========== Pipeline Failed =========="
        }

        unstable {
            echo "========== Pipeline Unstable =========="
        }
    }
}